# Gurukul auth service.
# NOTHING here is VITE_-prefixed: these are server-only secrets and must never
# reach the browser bundle.

NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/gurukul

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Two DIFFERENT secrets: a leaked access secret must not let an attacker mint
# refresh tokens.
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes
JWT_REFRESH_SECRET=replace-me-with-a-different-48-random-bytes

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

BCRYPT_COST=12

# Exact origin, never "*" — credentialed CORS forbids the wildcard.
CORS_ORIGIN=http://localhost:5173

# Set true only behind HTTPS. Locally the refresh cookie must not be Secure or
# the browser will drop it on http://localhost.
COOKIE_SECURE=false
